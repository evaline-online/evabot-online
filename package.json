{
  "name": "evabot-online",
  "version": "0.1.0",
  "description": "Evabot Online v0.0.1 MVP — Hybrid Multi-LLM, Consilium & Cyber-Terminal Agent System",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:client": "npx esbuild src/web/app.ts --bundle --outfile=dist/bundle.js --format=esm --target=es2022 --sourcemap",
    "build:server": "tsc",
    "build": "npm run build:server && npm run build:client",
    "test": "npx tsx tests/index.ts",
    "cli": "npx tsx src/cli/terminal-chat.ts",
    "start": "npx tsx src/server/server.ts",
    "docs:sync": "bash scripts/sync-docs.sh",
    "deploy": "bash scripts/safe-deploy.sh",
    "rollback": "bash scripts/rollback.sh"
  },
  "keywords": [
    "evabot",
    "gemini",
    "llm",
    "chat",
    "typescript",
    "google-ai-pro"
  ],
  "author": "EvaBot Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
